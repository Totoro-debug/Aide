{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://omni.local/protocol/v1.schema.json",
  "title": "Omni local service protocol v1",
  "$defs": {
    "identifier": {"type": "string", "minLength": 1},
    "request_id": {"$ref": "#/$defs/identifier"},
    "claim_version": {"type": "integer", "minimum": 1},
    "tool_permission_level": {"enum": ["read-only", "workspace-write", "full-access"]},
    "reasoning_effort": {"enum": ["low", "medium", "high", "xhigh", "max"]},
    "config_runtime_fields": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "max_tool_result_chars": {"type": "integer", "minimum": 1000, "maximum": 1000000},
        "max_iterations": {"type": "integer", "minimum": 50},
        "enable_skill_always_load": {"type": "boolean"},
        "compact_ratio": {"type": "number", "minimum": 0.5, "maximum": 0.95},
        "permission_level": {"$ref": "#/$defs/tool_permission_level"},
        "exec_shell": {"enum": ["auto", "powershell", "pwsh"]}
      }
    },
    "config_memory_fields": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "batch_size": {"type": "integer", "minimum": 1, "maximum": 1000},
        "schedule": {"type": "string", "minLength": 1}
      }
    },
    "config_redacted_secret": {
      "type": "object", "additionalProperties": false,
      "required": ["configured"],
      "properties": {"configured": {"type": "boolean"}}
    },
    "config_provider_fields": {
      "type": "object", "additionalProperties": false,
      "required": ["protocol", "base_url", "models", "api_key"],
      "properties": {
        "protocol": {"type": "string"},
        "base_url": {"type": "string"},
        "models": {"type": "array", "items": {"type": "string"}},
        "api_key": {"$ref": "#/$defs/config_redacted_secret"}
      }
    },
    "config_route_fields": {
      "type": "object", "additionalProperties": false,
      "required": ["provider_id", "model", "context_window", "max_output", "temperature", "reasoning_effort", "timeout"],
      "properties": {
        "provider_id": {"type": "string"},
        "model": {"type": "string"},
        "context_window": {"type": "integer", "minimum": 1024, "maximum": 10000000},
        "max_output": {"type": "integer", "minimum": 1, "maximum": 9999999},
        "temperature": {"type": "number", "minimum": 0, "maximum": 2},
        "reasoning_effort": {"$ref": "#/$defs/reasoning_effort"},
        "timeout": {"type": "integer", "minimum": 1, "maximum": 600}
      }
    },
    "config_mcp_fields": {
      "type": "object", "additionalProperties": false,
      "required": ["enabled", "transport", "command", "args", "cwd", "url", "headers", "connect_timeout", "call_timeout", "tool_keywords"],
      "properties": {
        "enabled": {"type": "boolean"},
        "transport": {"enum": ["stdio", "streamable-http"]},
        "command": {"type": ["string", "null"]},
        "args": {"type": "array", "items": {"type": "string"}},
        "cwd": {"type": ["string", "null"]},
        "url": {"type": ["string", "null"]},
        "headers": {
          "type": "object",
          "additionalProperties": {"$ref": "#/$defs/config_redacted_secret"}
        },
        "connect_timeout": {"type": "integer", "minimum": 1, "maximum": 600},
        "call_timeout": {"type": "integer", "minimum": 1, "maximum": 600},
        "tool_keywords": {
          "type": "object",
          "additionalProperties": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "config_models_fields": {
      "type": "object", "additionalProperties": false,
      "required": ["providers", "routes"],
      "properties": {
        "providers": {
          "type": "object",
          "additionalProperties": {"$ref": "#/$defs/config_provider_fields"}
        },
        "routes": {
          "type": "object",
          "additionalProperties": {"$ref": "#/$defs/config_route_fields"}
        }
      }
    },
    "config_patch_provider_fields": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "protocol": {"type": "string"},
        "base_url": {"type": "string"},
        "models": {"type": "array", "items": {"type": "string"}}
      }
    },
    "config_patch_route_fields": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "provider_id": {"type": "string"},
        "model": {"type": "string"},
        "context_window": {"type": "integer", "minimum": 1024, "maximum": 10000000},
        "max_output": {"type": "integer", "minimum": 1, "maximum": 9999999},
        "temperature": {"type": "number", "minimum": 0, "maximum": 2},
        "reasoning_effort": {"$ref": "#/$defs/reasoning_effort"},
        "timeout": {"type": "integer", "minimum": 1, "maximum": 600}
      }
    },
    "config_patch_mcp_fields": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "enabled": {"type": "boolean"},
        "transport": {"enum": ["stdio", "streamable-http"]},
        "command": {"type": ["string", "null"]},
        "args": {"type": "array", "items": {"type": "string"}},
        "cwd": {"type": ["string", "null"]},
        "url": {"type": ["string", "null"]},
        "headers": {
          "type": "object",
          "additionalProperties": {"$ref": "#/$defs/config_redacted_secret"}
        },
        "connect_timeout": {"type": "integer", "minimum": 1, "maximum": 600},
        "call_timeout": {"type": "integer", "minimum": 1, "maximum": 600},
        "tool_keywords": {
          "type": "object",
          "additionalProperties": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "config_patch_fields": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "runtime": {"$ref": "#/$defs/config_runtime_fields"},
        "memory": {"$ref": "#/$defs/config_memory_fields"},
        "models": {
          "type": "object", "additionalProperties": false,
          "properties": {
            "providers": {
              "type": "object",
              "additionalProperties": {"$ref": "#/$defs/config_patch_provider_fields"}
            },
            "routes": {
              "type": "object",
              "additionalProperties": {"$ref": "#/$defs/config_patch_route_fields"}
            }
          }
        },
        "mcp": {
          "type": "object",
          "additionalProperties": {"$ref": "#/$defs/config_patch_mcp_fields"}
        }
      }
    },
    "runtime_memory_config_patch": {
      "type": "object", "additionalProperties": false,
      "required": ["request_id", "revision", "fields"],
      "properties": {
        "request_id": {"$ref": "#/$defs/request_id"},
        "revision": {"$ref": "#/$defs/identifier"},
        "fields": {
          "type": "object", "additionalProperties": false,
          "properties": {
            "runtime": {"$ref": "#/$defs/config_runtime_fields"},
            "memory": {"$ref": "#/$defs/config_memory_fields"}
          }
        }
      }
    },
    "config_retry_request": {
      "type": "object", "additionalProperties": false,
      "required": ["request_id", "revision"],
      "properties": {
        "request_id": {"$ref": "#/$defs/request_id"},
        "revision": {"$ref": "#/$defs/identifier"}
      }
    },
    "config_fields": {
      "type": "object", "additionalProperties": false,
      "required": ["runtime", "memory", "models", "mcp"],
      "properties": {
        "runtime": {
          "$ref": "#/$defs/config_runtime_fields",
          "required": ["max_tool_result_chars", "max_iterations", "enable_skill_always_load", "compact_ratio", "permission_level", "exec_shell"]
        },
        "memory": {"$ref": "#/$defs/config_memory_fields", "required": ["batch_size", "schedule"]},
        "models": {"$ref": "#/$defs/config_models_fields"},
        "mcp": {
          "type": "object",
          "additionalProperties": {"$ref": "#/$defs/config_mcp_fields"}
        }
      }
    },
    "config_application_status": {"enum": ["active", "restart-required", "pending-repair"]},
    "config_projection_state": {"enum": ["active", "missing", "invalid", "malformed"]},
    "config_projection": {
      "type": "object", "additionalProperties": false,
      "required": ["state", "repair_required", "backup_required", "requires_secret_reentry", "error"],
      "properties": {
        "state": {"$ref": "#/$defs/config_projection_state"},
        "repair_required": {"type": "boolean"},
        "backup_required": {"type": "boolean"},
        "requires_secret_reentry": {"type": "boolean"},
        "error": {"anyOf": [
          {"type": "null"},
          {"type": "object", "additionalProperties": false, "required": ["code", "message"],
            "properties": {"code": {"type": "string"}, "message": {"type": "string"}}}
        ]}
      }
    },
    "config_application": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "saved_revision", "active_revision", "restart_required"],
      "properties": {
        "status": {"$ref": "#/$defs/config_application_status"},
        "saved_revision": {"type": "string"},
        "active_revision": {"type": ["string", "null"]},
        "restart_required": {"type": "boolean"}
      }
    },
    "config_response": {
      "type": "object", "additionalProperties": false,
      "required": ["revision", "fields", "configuration", "application"],
      "properties": {
        "revision": {"type": "string"},
        "fields": {"$ref": "#/$defs/config_fields"},
        "configuration": {"$ref": "#/$defs/config_projection"},
        "application": {"$ref": "#/$defs/config_application"}
      }
    },
    "config_mutation_response": {
      "type": "object", "additionalProperties": false,
      "required": ["request_id", "revision", "fields", "configuration", "application"],
      "properties": {
        "request_id": {"type": "string"},
        "revision": {"type": "string"},
        "fields": {"$ref": "#/$defs/config_fields"},
        "configuration": {"$ref": "#/$defs/config_projection"},
        "backup_id": {"type": ["string", "null"]},
        "application": {"$ref": "#/$defs/config_application"}
      }
    },
    "runtime_status_request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["request_id", "current_session_id", "claim_version"],
      "properties": {
        "request_id": {"$ref": "#/$defs/request_id"},
        "current_session_id": {"$ref": "#/$defs/identifier"},
        "claim_version": {"$ref": "#/$defs/claim_version"}
      }
    },
    "runtime_permission_request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["request_id", "current_session_id", "claim_version", "permission_level"],
      "properties": {
        "request_id": {"$ref": "#/$defs/request_id"},
        "current_session_id": {"$ref": "#/$defs/identifier"},
        "claim_version": {"$ref": "#/$defs/claim_version"},
        "permission_level": {"$ref": "#/$defs/tool_permission_level"}
      }
    },
    "runtime_effort_request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["request_id", "current_session_id", "claim_version", "effort"],
      "properties": {
        "request_id": {"$ref": "#/$defs/request_id"},
        "current_session_id": {"$ref": "#/$defs/identifier"},
        "claim_version": {"$ref": "#/$defs/claim_version"},
        "effort": {"$ref": "#/$defs/reasoning_effort"}
      }
    },
    "runtime_memory_request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["request_id", "current_session_id", "claim_version"],
      "properties": {
        "request_id": {"$ref": "#/$defs/request_id"},
        "current_session_id": {"$ref": "#/$defs/identifier"},
        "claim_version": {"$ref": "#/$defs/claim_version"}
      }
    },
    "runtime_dream_request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["request_id", "current_session_id", "claim_version"],
      "properties": {
        "request_id": {"$ref": "#/$defs/request_id"},
        "current_session_id": {"$ref": "#/$defs/identifier"},
        "claim_version": {"$ref": "#/$defs/claim_version"}
      }
    },
    "runtime_skills_reload_request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["request_id", "current_session_id", "claim_version"],
      "properties": {
        "request_id": {"$ref": "#/$defs/request_id"},
        "current_session_id": {"$ref": "#/$defs/identifier"},
        "claim_version": {"$ref": "#/$defs/claim_version"}
      }
    },
    "management_error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message", "retryable", "retry_after_seconds"],
      "properties": {
        "code": {"type": "string", "minLength": 1},
        "message": {"type": "string", "minLength": 1},
        "retryable": {"type": "boolean"},
        "retry_after_seconds": {"type": ["number", "null"], "minimum": 0}
      }
    },
    "dream_result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "processed_count", "memory_updated", "cursor", "error"],
      "properties": {
        "status": {"type": "string", "minLength": 1},
        "processed_count": {"type": "integer", "minimum": 0},
        "memory_updated": {"type": "boolean"},
        "cursor": {"type": "integer", "minimum": 0},
        "error": {"anyOf": [{"$ref": "#/$defs/management_error"}, {"type": "null"}]}
      }
    },
    "skill_metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "description", "path"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "description": {"type": "string"},
        "path": {"type": "string", "minLength": 1}
      }
    },
    "runtime_status": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version", "chat_model", "chat_reasoning_effort", "uptime_seconds", "context_window",
        "max_output", "available_context", "compact_ratio", "compact_context_window",
        "projected_next_request_tokens", "projection_source", "input_budget_used_percent",
        "session_message_count", "last_compacted", "cumulative_usage",
        "configured_permission_level", "current_permission_level"
      ],
      "properties": {
        "version": {"type": "string"},
        "chat_model": {"type": "string"},
        "chat_reasoning_effort": {"$ref": "#/$defs/reasoning_effort"},
        "uptime_seconds": {"type": "integer", "minimum": 0},
        "context_window": {"type": "integer", "minimum": 1},
        "max_output": {"type": "integer", "minimum": 0},
        "available_context": {"type": "integer", "minimum": 1},
        "compact_ratio": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
        "compact_context_window": {"type": "integer", "minimum": 1},
        "projected_next_request_tokens": {"type": "integer", "minimum": 0},
        "projection_source": {"enum": ["estimated", "reported_delta"]},
        "input_budget_used_percent": {"type": "number", "minimum": 0},
        "session_message_count": {"type": "integer", "minimum": 0},
        "last_compacted": {"type": "integer", "minimum": 0},
        "cumulative_usage": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
        "configured_permission_level": {"$ref": "#/$defs/tool_permission_level"},
        "current_permission_level": {"$ref": "#/$defs/tool_permission_level"},
        "schedule": {
          "type": "object", "additionalProperties": false,
          "properties": {
            "status": {"type": "string"},
            "active_job_count": {"type": "integer", "minimum": 0}
          }
        }
      }
    },
    "management_result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "handled", "output", "effort_selection", "permission_selection", "published_effort",
        "published_permission_level", "resumed_session_id", "resume_skipped_count"
      ],
      "properties": {
        "handled": {"type": "boolean"},
        "output": {"type": ["string", "null"]},
        "memory_content": {"type": ["string", "null"]},
        "dream_result": {"$ref": "#/$defs/dream_result"},
        "management_error": {"$ref": "#/$defs/management_error"},
        "status_view": {"$ref": "#/$defs/runtime_status"},
        "effort_selection": {"anyOf": [{"$ref": "#/$defs/reasoning_effort"}, {"type": "null"}]},
        "permission_selection": {"anyOf": [{"$ref": "#/$defs/tool_permission_level"}, {"type": "null"}]},
        "published_effort": {"anyOf": [{"$ref": "#/$defs/reasoning_effort"}, {"type": "null"}]},
        "published_permission_level": {"anyOf": [{"$ref": "#/$defs/tool_permission_level"}, {"type": "null"}]},
        "resumed_session_id": {"type": ["string", "null"]},
        "resume_skipped_count": {"type": "integer", "minimum": 0},
        "resume_sessions": {"type": "array", "items": {"type": "object"}},
        "skill_metadata": {"type": "array", "items": {"$ref": "#/$defs/skill_metadata"}},
        "restore_listing": {"type": "object"},
        "restore_plan": {"type": "object"},
        "restore_result": {"type": ["object", "null"]},
        "claim_version": {"$ref": "#/$defs/claim_version"},
        "claim_credential": {"$ref": "#/$defs/identifier"}
      }
    },
    "management_response": {
      "type": "object",
      "additionalProperties": false,
      "required": ["request_id", "result"],
      "properties": {
        "request_id": {"$ref": "#/$defs/request_id"},
        "result": {"$ref": "#/$defs/management_result"}
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message", "field_errors", "retryable", "request_id"],
      "properties": {
        "code": {"type": "string", "minLength": 1},
        "message": {"type": "string"},
        "field_errors": {"type": "object", "additionalProperties": {"type": "string"}},
        "retryable": {"type": "boolean"},
        "request_id": {"$ref": "#/$defs/request_id"}
      }
    },
    "ack": {
      "type": "object",
      "additionalProperties": false,
      "required": ["request_id", "accepted", "result"],
      "properties": {
        "request_id": {"$ref": "#/$defs/request_id"},
        "accepted": {"const": true},
        "result": {"type": "object"}
      }
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol_version", "service_instance_id", "stream_id", "seq", "type",
        "workspace_id", "project_id", "session_id", "run_id", "payload"
      ],
      "properties": {
        "protocol_version": {"const": 1},
        "service_instance_id": {"$ref": "#/$defs/identifier"},
        "stream_id": {"$ref": "#/$defs/identifier"},
        "seq": {"type": "integer", "minimum": 1},
        "type": {"type": "string", "minLength": 1},
        "workspace_id": {"$ref": "#/$defs/identifier"},
        "project_id": {"type": ["string", "null"]},
        "session_id": {"type": ["string", "null"]},
        "run_id": {"type": ["string", "null"]},
        "payload": {"type": "object"}
      }
    },
    "client_command": {
      "type": "object",
      "additionalProperties": false,
      "required": ["request_id", "type", "workspace_id", "session_id", "claim_version", "payload"],
      "properties": {
        "request_id": {"$ref": "#/$defs/request_id"},
        "type": {
          "enum": ["claim", "release", "input", "cancel", "confirmation_decide", "subscribe"]
        },
        "workspace_id": {"type": ["string", "null"]},
        "session_id": {"type": ["string", "null"]},
        "claim_version": {"type": ["integer", "null"], "minimum": 1},
        "payload": {"type": "object"}
      },
      "allOf": [
        {
          "if": {"properties": {"type": {"enum": ["claim", "release", "input", "cancel"]}}},
          "then": {
            "properties": {
              "workspace_id": {"$ref": "#/$defs/identifier"},
              "session_id": {"$ref": "#/$defs/identifier"}
            }
          }
        },
        {
          "if": {"properties": {"type": {"enum": ["release", "input", "cancel"]}}},
          "then": {"properties": {"claim_version": {"$ref": "#/$defs/claim_version"}}}
        },
        {
          "if": {"properties": {"type": {"const": "claim"}}},
          "then": {"properties": {"claim_version": {"const": null}}}
        },
        {
          "if": {"properties": {"type": {"enum": ["claim", "release"]}}},
          "then": {"properties": {"payload": {"type": "object", "maxProperties": 0}}}
        },
        {
          "if": {"properties": {"type": {"const": "input"}}},
          "then": {
            "properties": {
              "payload": {
                "type": "object", "additionalProperties": false,
                "required": ["text"],
                "properties": {"text": {"type": "string", "minLength": 1}}
              }
            }
          }
        },
        {
          "if": {"properties": {"type": {"const": "cancel"}}},
          "then": {
            "properties": {
              "payload": {
                "type": "object", "additionalProperties": false,
                "required": ["run_id"],
                "properties": {"run_id": {"$ref": "#/$defs/identifier"}}
              }
            }
          }
        },
        {
          "if": {"properties": {"type": {"const": "confirmation_decide"}}},
          "then": {
            "properties": {
              "payload": {
                "type": "object", "additionalProperties": false,
                "required": ["token", "decision"],
                "properties": {
                  "token": {"$ref": "#/$defs/identifier"},
                  "decision": {"enum": ["approved", "declined"]}
                }
              }
            }
          }
        },
        {
          "if": {"properties": {"type": {"const": "subscribe"}}},
          "then": {
            "properties": {
              "payload": {
                "type": "object", "additionalProperties": false,
                "required": ["last_seq"],
                "properties": {"last_seq": {"type": ["integer", "null"], "minimum": 1}}
              }
            }
          }
        }
      ]
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["workspace_id", "session_id", "claim_version", "reconnect_credential"],
      "properties": {
        "workspace_id": {"$ref": "#/$defs/identifier"},
        "session_id": {"$ref": "#/$defs/identifier"},
        "claim_version": {"$ref": "#/$defs/claim_version"},
        "reconnect_credential": {"$ref": "#/$defs/identifier"}
      }
    },
    "config_secret_change": {
      "oneOf": [
        {
          "type": "object", "additionalProperties": false,
          "required": ["action", "value"],
          "properties": {"action": {"const": "replace"}, "value": {"type": "string"}}
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["action"], "properties": {"action": {"const": "keep"}}
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["action"], "properties": {"action": {"const": "clear"}}
        }
      ]
    },
    "config_patch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["request_id", "revision", "fields", "secrets"],
      "properties": {
        "request_id": {"$ref": "#/$defs/request_id"},
        "revision": {"$ref": "#/$defs/identifier"},
        "fields": {"$ref": "#/$defs/config_patch_fields"},
        "secrets": {
          "type": "object", "additionalProperties": {"$ref": "#/$defs/config_secret_change"}
        }
      }
    },
    "redacted_secret": {
      "type": "object",
      "additionalProperties": false,
      "required": ["configured"],
      "properties": {"configured": {"type": "boolean"}}
    },
    "project_schedule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "at_time", "every_seconds", "cron_expr", "timezone"],
      "properties": {
        "kind": {"enum": ["at", "every", "cron"]},
        "at_time": {"type": ["string", "null"]},
        "every_seconds": {"type": ["integer", "null"], "minimum": 1},
        "cron_expr": {"type": ["string", "null"]},
        "timezone": {"type": ["string", "null"]}
      }
    },
    "project_job": {
      "type": "object",
      "additionalProperties": false,
      "required": ["job_id", "title", "schedule", "due_at", "review_status"],
      "properties": {
        "job_id": {"$ref": "#/$defs/identifier"},
        "title": {"type": "string", "minLength": 1},
        "schedule": {"$ref": "#/$defs/project_schedule"},
        "due_at": {"type": ["string", "null"]},
        "review_status": {"enum": ["overdue", "upcoming", "next_on_resume", "completed"]}
      }
    },
    "project_schedule_status": {
      "type": "object",
      "additionalProperties": false,
      "required": ["admitted", "status", "active_job_count"],
      "properties": {
        "admitted": {"type": "boolean"},
        "status": {"enum": ["available", "faulted"]},
        "active_job_count": {"type": "integer", "minimum": 0}
      }
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "project_id", "path", "name", "schedule_state", "available", "saved_jobs",
        "schedule_status"
      ],
      "properties": {
        "project_id": {"$ref": "#/$defs/identifier"},
        "path": {"type": "string", "minLength": 1},
        "name": {"type": "string"},
        "schedule_state": {
          "enum": ["available", "unavailable", "awaiting_resume", "removing", "failed"]
        },
        "available": {"type": "boolean"},
        "saved_jobs": {
          "type": "array",
          "items": {"$ref": "#/$defs/project_job"}
        },
        "schedule_status": {
          "anyOf": [
            {"$ref": "#/$defs/project_schedule_status"},
            {"type": "null"}
          ]
        },
        "removal_operation_id": {"$ref": "#/$defs/identifier"},
        "removal_error": {"type": "string", "minLength": 1}
      }
    },
    "projects_response": {
      "type": "object",
      "additionalProperties": false,
      "required": ["projects"],
      "properties": {
        "projects": {"type": "array", "items": {"$ref": "#/$defs/project"}}
      }
    },
    "project_registration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["request_id", "project_id", "workspace_id", "schedule_state", "saved_jobs"],
      "properties": {
        "request_id": {"$ref": "#/$defs/request_id"},
        "project_id": {"$ref": "#/$defs/identifier"},
        "workspace_id": {"$ref": "#/$defs/identifier"},
        "schedule_state": {
          "enum": ["available", "unavailable", "awaiting_resume", "removing", "failed"]
        },
        "saved_jobs": {"type": "array", "items": {"$ref": "#/$defs/project_job"}}
      }
    },
    "project_removal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["request_id", "project_id", "operation_id", "status"],
      "properties": {
        "request_id": {"$ref": "#/$defs/request_id"},
        "project_id": {"$ref": "#/$defs/identifier"},
        "operation_id": {"$ref": "#/$defs/identifier"},
        "status": {"enum": ["removing", "completed", "failed"]}
      }
    },
    "project_removal_status": {
      "type": "object",
      "additionalProperties": false,
      "required": ["project_id", "operation_id", "status"],
      "properties": {
        "project_id": {"$ref": "#/$defs/identifier"},
        "operation_id": {"$ref": "#/$defs/identifier"},
        "status": {"enum": ["removing", "completed", "failed"]}
      }
    },
    "project_schedule_resume": {
      "type": "object",
      "additionalProperties": false,
      "required": ["request_id", "schedule_state"],
      "properties": {
        "request_id": {"$ref": "#/$defs/request_id"},
        "schedule_state": {
          "enum": ["available", "unavailable", "awaiting_resume", "removing", "failed"]
        }
      }
    },
    "session": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "title", "created_at", "updated_at", "message_count", "occupied", "occupied_by",
        "metadata_version"
      ],
      "properties": {
        "id": {"$ref": "#/$defs/identifier"},
        "title": {"type": "string", "minLength": 1},
        "created_at": {"type": "string", "minLength": 1},
        "updated_at": {"type": "string", "minLength": 1},
        "message_count": {"type": "integer", "minimum": 0},
        "occupied": {"type": "boolean"},
        "occupied_by": {"type": ["string", "null"]},
        "metadata_version": {"type": "integer", "minimum": 0}
      }
    },
    "session_snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["session_id", "messages", "restore_anchors", "live_state"],
      "properties": {
        "session_id": {"$ref": "#/$defs/identifier"},
        "live_state": {"anyOf": [{"$ref": "#/$defs/session_live_state"}, {"type": "null"}]},
        "messages": {"type": "array", "items": {"type": "object"}},
        "restore_anchors": {
          "type": "array",
          "items": {"$ref": "#/$defs/restore_anchor"}
        }
      }
    },
    "restore_anchor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["anchor_id", "run_token", "content", "timestamp"],
      "properties": {
        "anchor_id": {"type": "integer", "minimum": 1},
        "run_token": {"$ref": "#/$defs/identifier"},
        "content": {"type": "string"},
        "timestamp": {"type": "string", "minLength": 1}
      }
    },
    "session_claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["workspace_id", "session_id", "claim_version", "reconnect_credential"],
      "properties": {
        "workspace_id": {"$ref": "#/$defs/identifier"},
        "session_id": {"$ref": "#/$defs/identifier"},
        "claim_version": {"$ref": "#/$defs/claim_version"},
        "reconnect_credential": {"$ref": "#/$defs/identifier"}
      }
    },
    "project_sessions_response": {
      "type": "object",
      "additionalProperties": false,
      "required": ["project_id", "workspace_id", "sessions", "next_cursor"],
      "properties": {
        "project_id": {"$ref": "#/$defs/identifier"},
        "workspace_id": {"$ref": "#/$defs/identifier"},
        "sessions": {"type": "array", "items": {"$ref": "#/$defs/session"}},
        "next_cursor": {"type": ["string", "null"]}
      }
    },
    "session_creation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["request_id", "project_id", "workspace_id", "session_id"],
      "properties": {
        "request_id": {"$ref": "#/$defs/request_id"},
        "project_id": {"$ref": "#/$defs/identifier"},
        "workspace_id": {"$ref": "#/$defs/identifier"},
        "session_id": {"$ref": "#/$defs/identifier"}
      }
    },
    "session_claim_response": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "request_id", "project_id", "workspace_id", "session_id", "claim", "snapshot"
      ],
      "properties": {
        "request_id": {"$ref": "#/$defs/request_id"},
        "project_id": {"$ref": "#/$defs/identifier"},
        "workspace_id": {"$ref": "#/$defs/identifier"},
        "session_id": {"$ref": "#/$defs/identifier"},
        "claim": {"$ref": "#/$defs/session_claim"},
        "snapshot": {"$ref": "#/$defs/session_snapshot"}
      }
    },
    "session_release": {
      "type": "object",
      "additionalProperties": false,
      "required": ["request_id", "released"],
      "properties": {
        "request_id": {"$ref": "#/$defs/request_id"},
        "released": {"const": true}
      }
    },
    "session_deletion_status": {
      "type": "object",
      "additionalProperties": false,
      "required": ["project_id", "workspace_id", "session_id", "state"],
      "properties": {
        "project_id": {"$ref": "#/$defs/identifier"},
        "workspace_id": {"$ref": "#/$defs/identifier"},
        "session_id": {"$ref": "#/$defs/identifier"},
        "state": {"enum": ["deleted", "deleting", "present"]}
      }
    },
    "session_deletion_claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["request_id", "project_id", "workspace_id", "session_id", "claim"],
      "properties": {
        "request_id": {"$ref": "#/$defs/request_id"},
        "project_id": {"$ref": "#/$defs/identifier"},
        "workspace_id": {"$ref": "#/$defs/identifier"},
        "session_id": {"$ref": "#/$defs/identifier"},
        "claim": {"$ref": "#/$defs/session_claim"}
      }
    },
    "session_deletion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["request_id", "project_id", "workspace_id", "session_id", "deleted"],
      "properties": {
        "request_id": {"$ref": "#/$defs/request_id"},
        "project_id": {"$ref": "#/$defs/identifier"},
        "workspace_id": {"$ref": "#/$defs/identifier"},
        "session_id": {"$ref": "#/$defs/identifier"},
        "deleted": {"const": true}
      }
    },
    "active_tool_snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tool_call_id",
        "name",
        "arguments",
        "status"
      ],
      "properties": {
        "tool_call_id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "arguments": {
          "type": "string"
        },
        "status": {
          "enum": [
            "running",
            "completed",
            "failed",
            "rejected",
            "canceled",
            "unknown"
          ]
        }
      }
    },
    "active_run_snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run_id",
        "request_id",
        "prompt",
        "status",
        "assistant_content",
        "tools",
        "cancel_requested",
        "cancellable"
      ],
      "properties": {
        "run_id": {
          "$ref": "#/$defs/identifier"
        },
        "request_id": {
          "$ref": "#/$defs/request_id"
        },
        "prompt": {
          "type": "string"
        },
        "status": {
          "enum": [
            "accepted",
            "running"
          ]
        },
        "assistant_content": {
          "type": "string"
        },
        "tools": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/active_tool_snapshot"
          }
        },
        "cancel_requested": {
          "type": "boolean"
        },
        "cancellable": {
          "type": "boolean"
        }
      }
    },
    "session_live_state": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stream_id",
        "seq",
        "runs"
      ],
      "properties": {
        "stream_id": {
          "$ref": "#/$defs/identifier"
        },
        "seq": {
          "type": "integer",
          "minimum": 0
        },
        "runs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/active_run_snapshot"
          }
        }
      }
    },
    "confirmation_request": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "confirmation_id",
        "tool_call_id",
        "tool_name",
        "reason",
        "summary",
        "details",
        "warnings"
      ],
      "properties": {
        "confirmation_id": {
          "type": "string"
        },
        "tool_call_id": {
          "type": "string"
        },
        "tool_name": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        },
        "summary": {
          "type": "string"
        },
        "details": {
          "type": "object",
          "additionalProperties": {}
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "confirmation_event_owner": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "generation_id"
      ],
      "properties": {
        "kind": {
          "$ref": "#/$defs/confirmation_origin"
        },
        "generation_id": {
          "type": "string"
        },
        "run_id": {
          "type": "string"
        },
        "job_id": {
          "type": "string"
        },
        "occurrence_id": {
          "type": "string"
        }
      }
    },
    "confirmation_requested_payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "token",
        "origin",
        "request"
      ],
      "properties": {
        "token": {
          "type": "string"
        },
        "origin": {
          "$ref": "#/$defs/confirmation_origin"
        },
        "request": {
          "$ref": "#/$defs/confirmation_request"
        },
        "job_id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "owner": {
          "$ref": "#/$defs/confirmation_event_owner"
        }
      }
    },
    "pending_confirmation_snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workspace_id",
        "project_id",
        "session_id",
        "run_id",
        "payload"
      ],
      "properties": {
        "workspace_id": {
          "$ref": "#/$defs/identifier"
        },
        "project_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "session_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "run_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "payload": {
          "$ref": "#/$defs/confirmation_requested_payload"
        }
      }
    },
    "session_recovery_snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workspace_id",
        "claim_version",
        "snapshot"
      ],
      "properties": {
        "workspace_id": {
          "$ref": "#/$defs/identifier"
        },
        "claim_version": {
          "type": "integer"
        },
        "snapshot": {
          "$ref": "#/$defs/session_snapshot"
        }
      }
    },
    "recovery_snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sessions",
        "pending_confirmation"
      ],
      "properties": {
        "sessions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/session_recovery_snapshot"
          }
        },
        "pending_confirmation": {
          "anyOf": [
            {
              "$ref": "#/$defs/pending_confirmation_snapshot"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "confirmation_origin": {
      "enum": [
        "foreground",
        "background"
      ]
    }
  }
}
