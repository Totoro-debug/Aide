{
  "name": "omni-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc -b",
    "lint": "eslint . --max-warnings 0",
    "protocol-check": "node scripts/check-protocol.mjs",
    "build": "npm run protocol-check && npm run typecheck && vite build && node scripts/copy-assets.mjs",
    "pretest:e2e": "npm run build",
    "test:e2e": "node scripts/e2e-runner.mjs",
    "pretest:e2e:startup": "npm run build",
    "test:e2e:startup": "node scripts/config-startup-e2e.mjs"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "1.1.14",
    "i18next": "25.2.1",
    "lucide-react": "0.511.0",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "react-i18next": "15.5.1",
    "react-markdown": "10.1.0",
    "react-router-dom": "7.6.2",
    "remark-gfm": "4.0.1"
  },
  "devDependencies": {
    "@eslint/js": "9.25.1",
    "@playwright/test": "1.52.0",
    "@types/node": "22.15.17",
    "@types/react": "19.1.2",
    "@types/react-dom": "19.1.2",
    "@vitejs/plugin-react": "4.4.1",
    "eslint": "9.25.1",
    "eslint-plugin-react-hooks": "5.2.0",
    "eslint-plugin-react-refresh": "0.4.19",
    "typescript": "5.8.3",
    "typescript-eslint": "8.31.1",
    "vite": "6.3.5"
  }
}
